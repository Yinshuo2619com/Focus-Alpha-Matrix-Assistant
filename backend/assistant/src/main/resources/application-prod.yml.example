server:
  port: 8080
  address: 127.0.0.1

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/edu_assistant?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: your_db_username
    password: your_db_password
    driver-class-name: com.mysql.cj.jdbc.Driver
  data:
    redis:
      host: localhost
      port: 6379
      password: your_redis_password
  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 20MB

mybatis-plus:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.educate.assistant.entity
  global-config:
    db-config:
      id-type: auto
  configuration:
    map-underscore-to-camel-case: true

jwt:
  secret: your_jwt_secret_base64
  expiration: 302400000

avatar:
  upload-dir: /www/wwwroot/assistant/uploads/avatar

cos:
  secret-id: your_cos_secret_id
  secret-key: your_cos_secret_key
  bucket-name: your_bucket_name
  region: ap-shanghai
  url-prefix: https://your-domain.com
